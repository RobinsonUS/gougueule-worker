{
  "name": "gougueule",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "rules": [
  { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
  { "type": "Data", "globs": ["**/*.png"],  "fallthrough": false }
],
  "vars": { "GAME_SERVER_URL": "wss://gougueule-server.onrender.com" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gougueule-db",
    "database_id": "54e26d7f-0c95-464a-bd6e-413bd2fc51ae"
  }]
}
