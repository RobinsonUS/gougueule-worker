{
  "name": "gougueule",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",

  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ],

  "vars": {
    "GAME_SERVER_URL": "wss://gougueule-server.onrender.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gougueule-db",
      "database_id": "REMPLACE-PAR-TON-DATABASE-ID"
    }
  ]
}
